# Copy to .env and adjust. Never commit .env.

# --- Database -------------------------------------------------------------
# Option A (recommended target): Supabase. In the Supabase dashboard open
# Project Settings -> Database -> Connection string. Keep the `postgresql+psycopg://`
# driver prefix and URL-encode special characters in the password.
#
#   Session pooler (IPv4, recommended for this app and for migrations):
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler (port 6543; prepared statements are disabled automatically):
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Direct connection (IPv6 unless the IPv4 add-on is enabled):
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# DATABASE_SSL_MODE=require
# DATABASE_POOLER_MODE=auto     # auto | direct | session | transaction
#
# Option B: local PostgreSQL via `docker compose up -d db` (offline development).
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agentforge:change-me@127.0.0.1:5432/agentforge
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Used only by `docker compose` for the backend container (defaults to the bundled db).
# COMPOSE_DATABASE_URL=

# --- HTTP -------------------------------------------------------------------
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]
MAX_REQUEST_BYTES=1000000
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Authentication (Supabase Auth + Google) -------------------------------
# Backend: https://<project-ref>.supabase.co. Tokens are verified with the project's
# public signing keys (JWKS), so no Supabase secret is needed. Unset = API returns 503.
SUPABASE_URL=
# Frontend (bundled into the browser app by design; only VITE_* vars are exposed).
# Publishable key: Supabase dashboard -> Project Settings -> API Keys (or the legacy anon key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- LLM ----------------------------------------------------------------------
# google   : Gemini (needs LLM_API_KEY), e.g. LLM_MODEL=gemini-2.5-flash
# ollama   : local model, e.g. LLM_MODEL=qwen2.5-coder:7b (LLM_BASE_URL defaults to localhost)
# scripted : deterministic DEMO model - fixed sample project, not AI (no key needed)
# The key is read server-side only and never returned by the API.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=180
# Cap on one answer's length (stops a model stuck repeating itself) and the wall-clock
# budget for one agent call including retries.
LLM_MAX_OUTPUT_TOKENS=8192
LLM_CALL_BUDGET_SECONDS=600
# Ollama thinking models (qwen3, qwen3.5): false turns thinking off. Leave blank otherwise.
LLM_THINKING=
# Optional: per-million-token prices for cost estimates (unset = reported as unknown).
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
# LangSmith tracing (optional): LANGSMITH_TRACING=true, LANGSMITH_API_KEY=..., LANGSMITH_PROJECT=agentforge

# --- Knowledge base (RAG) -------------------------------------------------------
# hash   : deterministic, no model (default; matches shared words only)
# ollama : local embeddings, e.g. EMBEDDING_MODEL=nomic-embed-text (`ollama pull nomic-embed-text`)
# google : Gemini embeddings (uses LLM_API_KEY), default models/gemini-embedding-001
# Switching embedders makes existing documents "stale" until re-indexed (Knowledge Base page).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
# Retrieval pipeline: dense + BM25 fused (hybrid), reranked, relevance-gated, top k.
# RAG_RERANKER=llm grades passages with the chat model (more precise, one model call per retrieval).
RAG_MODE=hybrid
RAG_RERANKER=lexical
RAG_TOP_K=4
RAG_MIN_SCORE=0.15

# --- Run execution ------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
MAX_ACTIVE_RUNS_PER_USER=2
MAX_RUNS_PER_USER_PER_HOUR=20
# Sandbox: build once with `docker build -t agentforge-sandbox-python:1 docker/sandbox`
SANDBOX_ENABLED=true
SANDBOX_IMAGE=agentforge-sandbox-python:2
# Projects with Database = PostgreSQL get a throwaway database per test run (docker pull postgres:17-alpine).
SANDBOX_DATABASE_IMAGE=postgres:17-alpine
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512

# --- Workflow policy --------------------------------------------------------
MAX_DEBUG_ITERATIONS=3
MAX_REVIEW_CORRECTIONS=1
